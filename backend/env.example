# Configuration du serveur
PORT=5000

# Connexion MongoDB
# Option 1: Local avec Docker (recommandé pour les tests)
MONGODB_URI=mongodb://localhost:27017/utasks

# Option 2: MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/utasks

# URL du frontend (pour CORS)
FRONTEND_URL=http://localhost:3000

# JWT Configuration (Authentication - Livrable 2)
# ⚠️ IMPORTANT: Changez cette valeur en production!
# Pour les tests, vous pouvez utiliser n'importe quelle valeur
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

